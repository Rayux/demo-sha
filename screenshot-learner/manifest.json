{
  "manifest_version": 3,
  "name": "Screenshot Learner",
  "version": "0.4.0",
  "description": "Translate copied Japanese into Traditional Chinese and ask follow-up questions.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "sidePanel",
    "clipboardRead",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-study": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Ctrl+Shift+Y"
      },
      "description": "Capture the visible tab and explain the Japanese"
    },
    "clipboard-study": {
      "suggested_key": {
        "default": "Ctrl+Shift+7",
        "mac": "Command+Shift+7"
      },
      "description": "Translate copied text into Traditional Chinese",
      "global": true
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Open Japanese study",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "result.html"
  }
}
