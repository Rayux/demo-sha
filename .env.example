# Groq API key for ultra-fast transcription and language tutoring
# Get a free key from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq Whisper model (default)
GROQ_MODEL=whisper-large-v3-turbo

# Groq Chat model (default)
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Firebase Configuration (for permanent transcript storage across Render deploys)
# Get these from your Firebase Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
