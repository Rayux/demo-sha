# Groq API key for ultra-fast transcription and language tutoring
# Get a free key from console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq Whisper model (default)
GROQ_MODEL=whisper-large-v3-turbo

# Groq Chat model (default)
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Optional: Azure Speech scores your pronunciation from the recording itself.
# Without it the pronunciation score is only an estimate from the transcript.
# Create a Speech resource in the Azure portal, then copy its key and region.
# AZURE_SPEECH_KEY=your_azure_speech_key_here
# AZURE_SPEECH_REGION=japaneast
# Settings shows how much of the monthly allowance this site has used.
# Change this if the Azure portal shows a different free allowance (hours).
# AZURE_SPEECH_MONTHLY_HOURS=5

# Firebase Configuration (for permanent transcript storage across Render deploys)
# Get these from your Firebase Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
