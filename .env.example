# Paste your Google AI Studio key here. It is read only by the local server.
GEMINI_API_KEY=your_google_ai_studio_key_here

# Gemini model (highest quality for grammar, translation & tutoring)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Groq Whisper for ultra-fast transcription (free key from console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Optional: OpenAI API key (for Whisper-1 transcription & GPT-4o analysis/evaluation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
