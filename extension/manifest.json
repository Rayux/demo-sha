{
  "manifest_version": 3,
  "name": "Kage Shadowing Extension",
  "version": "1.7.27",
  "description": "Japanese shadowing extension for Netflix, YouTube, Bilibili, and Anime1.me with real-time AI translations.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://*.anime1.me/*",
    "https://*.v.anime1.me/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "optional_host_permissions": ["https://*.googlevideo.com/*"],
  "action": {
    "default_title": "Kage Shadowing"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "vendor/googlevideo/sabr.js",
        "content/youtube-sabr-main.js",
        "content/youtube-audio-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": [
        "content/netflix-tracks.js",
        "content/bilibili-audio-main.js",
        "content/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.anime1.me/*"],
      "js": [
        "content/anime1-audio-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.anime1.me/*"
      ],
      "js": [
        "vendor/kuromoji/kuromoji.js",
        "content/subtitles.js",
        "content/readings.js",
        "content/prepare.js",
        "content/browser-audio.js",
        "content/imported.js",
        "content/tutor.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "minimum_chrome_version": "111",
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/kuromoji/dict/*.gz"
      ],
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://*.anime1.me/*"
      ]
    }
  ]
}
