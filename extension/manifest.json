{
  "manifest_version": 3,
  "name": "Kage Shadowing Extension",
  "version": "1.7.6",
  "description": "Japanese shadowing extension for Netflix, YouTube, and Bilibili with real-time AI translations.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "action": {
    "default_title": "Kage Shadowing"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": [
        "content/netflix-tracks.js",
        "content/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": [
        "vendor/kuromoji/kuromoji.js",
        "content/subtitles.js",
        "content/readings.js",
        "content/prepare.js",
        "content/imported.js",
        "content/tutor.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "minimum_chrome_version": "111",
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/kuromoji/dict/*.gz"
      ],
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*"
      ]
    }
  ]
}
